# Windows scripts keep CRLF line endings; start-pitboard.ps1 is UTF-8 with a BOM so Windows PowerShell 5.1 reads its Korean text
*.ps1 text eol=crlf
*.cmd text eol=crlf
# Vendored libraries are checked by the page's integrity hash: keep their bytes exactly (no CRLF on Windows checkouts)
server/public/vendor/** -text
