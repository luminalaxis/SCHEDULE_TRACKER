# systemd unit for the FSK 피트보드 server on a Raspberry Pi.
# Install:  sudo cp deploy/fsk-pitboard.service /etc/systemd/system/
#           (edit User / WorkingDirectory / DATA_DIR below if your paths differ)
#           sudo systemctl daemon-reload && sudo systemctl enable --now fsk-pitboard
[Unit]
Description=FSK 피트보드
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/SCHEDULE_TRACKER
Environment=PORT=8080
# Listen only on the Pi itself; Cloudflare Tunnel (or Tailscale) carries outside traffic in.
Environment=HOST=127.0.0.1
Environment=DATA_DIR=/home/pi/fsk-data
# Local time for notifications (quiet before 08:00) and the daily backup hour.
Environment=TZ=Asia/Seoul
# Trust the tunnel's forwarded headers (real client IP, https). Only safe while HOST=127.0.0.1.
Environment=TRUST_PROXY=1
# Check-in address called after each day's backup (healthchecks.io etc.); a missed check-in alerts your phone.
# Environment=HEALTH_PING_URL=https://hc-ping.com/<your-check-uuid>
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/pi/fsk-data
# Off-site copy folder (관리 창 → 백업·복원 → 외부 복사). Uncomment and match the folder you set there:
# ReadWritePaths=/media/pi/BACKUP
PrivateTmp=true

[Install]
WantedBy=multi-user.target
